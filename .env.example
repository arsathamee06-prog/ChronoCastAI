# Environment Configuration

# Flask Configuration
FLASK_ENV=development
FLASK_PORT=5000
SECRET_KEY=your-secret-key-change-in-production

# Database
DATABASE_URL=sqlite:///timeseries.db

# ML/AI Configuration
MODEL_SAVE_PATH=./models
DATA_UPLOAD_PATH=./data
MAX_UPLOAD_SIZE=52428800

# Forecasting Configuration
DEFAULT_FORECAST_HORIZON=30
TEST_SIZE=0.2
VALIDATION_SIZE=0.1

# API Configuration
CORS_ENABLED=True
DEBUG=True

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/timeseries_ai.log
